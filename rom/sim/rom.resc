# The WB32 ROM bootloader on the Akko machine, for Renode. Uses the board
# sim's platform and peripheral models (../../sim), so they stay in step;
# ROM-specific models are in peripherals/ here:
#   usb_rom.py  the USB host model, with the vendor bulk pipe (see its header)
#   sys.py      SYS identification (GET_INFO)
#   fmc.py      the flash controller (ERASE, WRITE_PAGE)
# Then loads rom.bin at 0x1FFFE000 and info.bin at 0x1FFFF000 from $dump
# ($ROM_WORK/dump, outside the repo: rom/README.md). Callers:
#   $dump=@/path/to/dump      (the default is ../wb32-rom-re/dump beside the repo)
#   include @rom/sim/rom.resc
#   runMacro $enter_rom      reset, then SP/PC from the ROM's vector table, as
#                            boot-guard's jump on the board (Renode resets
#                            VectorTableOffset, so a plain reset boots from 0)

$repo?=$ORIGIN/../../sim
$dump?=$ORIGIN/../../../wb32-rom-re/dump

mach create "rom"
machine LoadPlatformDescription $repo/wb32fq95.repl
machine PyDevFromFile $repo/peripherals/gpio.py 0x40000000 0x2000 True "gpio"
machine PyDevFromFile $repo/peripherals/sysctl.py 0x40010000 0x1000 True "sysctl"
machine PyDevFromFile $repo/peripherals/cache.py 0x40015400 0x400 True "cache"
machine PyDevFromFile $ORIGIN/peripherals/usb_rom.py 0x40014000 0x1000 True "usb"
machine PyDevFromFile $ORIGIN/peripherals/sys.py 0x40016400 0x100 True "sys"
machine PyDevFromFile $ORIGIN/peripherals/fmc.py 0x40017800 0x200 True "fmc"
logLevel 3 gpio

sysbus LoadBinary $dump/rom.bin 0x1FFFE000
sysbus LoadBinary $dump/info.bin 0x1FFFF000

macro enter_rom
"""
    machine Reset
    cpu SP 0x20000450
    cpu PC 0x1FFFE091
"""
