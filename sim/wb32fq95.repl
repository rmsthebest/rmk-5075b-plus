// WB32FQ95xB as used on the Akko 5075B Plus, for Renode.
// Addresses from ChibiOS-contrib's wb32fq95xx.h. Only what our firmware touches
// is modelled; every other access is logged by Renode as "unhandled".

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m3"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 96000000
    IRQ -> cpu@0

// DWT cycle counter (CYCCNT at 96 MHz). QMK's ChibiOS busy-waits on it.
dwt: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 96000000

// Boot ROM (DFU bootloader). We don't have its contents; sim/akko.resc loads a
// stub whose reset handler parks in a loop at ROM_PARKED, which tests detect.
rom: Memory.MappedMemory @ sysbus 0x1FFFE000
    size: 0x2000

// 256K: the chip is a WB32FQ95xC, as the DFU tool reports. Booting from
// flash maps it at 0 as well, which is where the core fetches the initial SP
// and reset vector.
flash: Memory.MappedMemory @ {
        sysbus 0x08000000;
        sysbus 0x00000000
    }
    size: 0x40000

// 36K on the die; QMK links 28K and keeps the bootloader magic at 0x2000_6FFC.
sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x9000

// The WB32-specific peripherals are Python models added by akko.resc
// (machine PyDevFromFile), because .repl files can't locate them by path:
//   gpio   0x4000_0000  ports A-D, AFIO, EXTI + key matrix  peripherals/gpio.py
//   sysctl 0x4001_0000  PWR, ANCTL, IWDG, RCC            peripherals/sysctl.py
//   cache  0x4001_5400  flash cache controller           peripherals/cache.py

// TIM2: same register layout as an STM32 general-purpose timer (CR1..CCR4,
// BDTR), 16-bit counter (akko.resc drops the upper bits of CNT, ARR and
// CCRx writes, as the chip does), clocked from PCLK1 (96 MHz with our clock setup).
// Renode's model counts in virtual time. QMK doesn't use TIM2 (its ChibiOS
// tick is SysTick), so there's no reference run; tests/m2_hal.robot checks
// our time driver against virtual time instead.
tim2: Timers.STM32_Timer @ sysbus 0x40002000
    frequency: 96000000
    initialLimit: 0xFFFF
    -> nvic@21
