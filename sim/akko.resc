# Akko 5075B Plus machine for Renode. Callers load an image afterwards:
#   include @sim/akko.resc
#   sysbus LoadELF @target/thumbv7m-none-eabi/release/m1b-stub      (Rust)
#   sysbus LoadBinary @../akko_5075b_plus_fixes.bin 0x08000000       (QMK .bin)
#   machine Reset                                                    (boot from flash)

mach create "akko"
machine LoadPlatformDescription $ORIGIN/wb32fq95.repl
# TIM2 is 16-bit on this chip (ChibiOS: WB32_TIM2_IS_32BITS FALSE); Renode's
# STM32_Timer is 32-bit. Drop the upper bits of CNT, ARR and CCR1-4 writes.
sysbus SetHookBeforePeripheralWrite tim2 "value = value & 0xFFFF if offset in (0x24, 0x2C, 0x34, 0x38, 0x3C, 0x40) else value"
machine PyDevFromFile $ORIGIN/peripherals/gpio.py 0x40000000 0x2000 True "gpio"
machine PyDevFromFile $ORIGIN/peripherals/sysctl.py 0x40010000 0x1000 True "sysctl"
machine PyDevFromFile $ORIGIN/peripherals/cache.py 0x40015400 0x400 True "cache"
machine PyDevFromFile $ORIGIN/peripherals/usb.py 0x40014000 0x1000 True "usb"
machine PyDevFromFile $ORIGIN/peripherals/qspi.py 0x40003000 0x100 True "qspi"
machine PyDevFromFile $ORIGIN/peripherals/spim2.py 0x40009000 0x100 True "spim2"

# ROM stub at the DFU bootloader address: initial SP, then a reset handler that
# spins at 0x1FFF_E008 (ROM_PARKED). "PC is at 0x1FFFE008" = "entered DFU".
sysbus WriteDoubleWord 0x1FFFE000 0x20001000
sysbus WriteDoubleWord 0x1FFFE004 0x1FFFE009
sysbus WriteWord 0x1FFFE008 0xE7FE
